# ── Atlas configuration ───────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# GNews.io free tier — 100 requests/day, no credit card.
# Get a key at https://gnews.io/  ->  Dashboard -> API key
GNEWS_API_KEY=

# Ollama local REST endpoint (default install needs no changes)
OLLAMA_HOST=http://localhost:11434

# Model to use as Atlas's local brain. Pull it first:  ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Optional second, hosted brain (Google Gemini). Works with or without Ollama.
# Get a free key at https://aistudio.google.com/apikey
# Also powers Live Voice mode (real-time spoken conversation) when set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
