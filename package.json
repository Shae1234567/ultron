{
  "name": "ultron",
  "productName": "Ultron",
  "private": true,
  "version": "2.0.0",
  "description": "Personal AI command center: animated HUD, a seven-agent team that works in parallel, Obsidian-vault memory, Composio app connections, D2L, tasks with reminders, and a hidden research browser",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir",
    "postinstall": "playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@composio/core": "^0.21.0",
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "kokoro-js": "^1.2.1",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.62.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.140.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@mozilla/readability": "^0.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vectorize-io/hindsight-client": "^0.10.2",
    "@vitejs/plugin-react": "^4.3.3",
    "@xenova/transformers": "^2.17.2",
    "chrono-node": "^2.10.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.11.17",
    "mathjs": "^15.2.0",
    "minisearch": "^7.2.0",
    "png-to-ico": "^3.0.2",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.shae.ultron",
    "productName": "Ultron",
    "executableName": "Ultron",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/@huggingface/transformers/node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!node_modules/@huggingface/transformers/node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**",
      "!node_modules/@huggingface/transformers/dist/*.map",
      "!node_modules/@huggingface/transformers/dist/transformers.web*",
      "!node_modules/@huggingface/transformers/dist/transformers.js",
      "!node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!node_modules/@huggingface/transformers/dist/ort-wasm*",
      "!node_modules/kokoro-js/dist/kokoro.web.js"
    ],
    "extraResources": [
      {
        "from": "build-assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "pytools",
        "to": "pytools",
        "filter": [
          "*.py"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/playwright-core/**",
      "**/node_modules/@huggingface/transformers/node_modules/onnxruntime-node/**",
      "**/node_modules/@img/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build-assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Ultron",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
